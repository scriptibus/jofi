{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/paraglide", "!src/api/generated", "!dist", "!playwright-report", "!test-results"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": ["./lint/no-raw-style-values.grit"],
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noDeprecatedImports": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-aria-components": "Feature code uses our components from src/ui, not React Aria directly. Add or extend a component in src/ui instead.",
              "react-aria": "Feature code uses our components from src/ui, not React Aria hooks directly.",
              "react-stately": "Feature code uses our components from src/ui, not React Stately directly."
            },
            "patterns": [
              {
                "group": [
                  "react-aria-components/*",
                  "react-aria/*",
                  "react-stately/*",
                  "@react-aria/*",
                  "@react-stately/*"
                ],
                "message": "Feature code uses our components from src/ui, not React Aria directly."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
