+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.domain
+
+/** Yearly gross salary range from a posting, in whole euros. */
+data class SalaryRange(
+    val minimum: Int,
+    val maximum: Int,
+) {
+    init {
+        require(minimum >= 0) { "Minimum salary must not be negative" }
+        require(maximum >= minimum) { "Maximum salary must not be below the minimum" }
+    }
+
+    fun contains(amount: Int): Boolean = amount in minimum..maximum
+}
