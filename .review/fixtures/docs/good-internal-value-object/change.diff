@@ -0,0 +1,22 @@
+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.domain
+
+import kotlin.test.Test
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class SalaryRangeTest {
+    @Test
+    fun `contains amounts inside the range`() {
+        assertTrue(SalaryRange(50_000, 60_000).contains(55_000))
+        assertFalse(SalaryRange(50_000, 60_000).contains(61_000))
+    }
+
+    @Test
+    fun `rejects a maximum below the minimum`() {
+        assertFailsWith<IllegalArgumentException> { SalaryRange(60_000, 50_000) }
+    }
+}
