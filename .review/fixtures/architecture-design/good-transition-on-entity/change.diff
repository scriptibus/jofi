+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.application
+
+import io.github.scriptibus.jofi.applications.domain.TransitionRejection
+import io.github.scriptibus.jofi.applications.domain.TransitionResult
+
+sealed interface ChangeStatusOutcome {
+    data class Changed(val transition: TransitionResult.Moved) : ChangeStatusOutcome
+
+    data class NotAllowed(val reason: TransitionRejection) : ChangeStatusOutcome
+
+    data object NotFound : ChangeStatusOutcome
+}
