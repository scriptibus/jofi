@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.domain
+
+/** Outcome of asking an application to move to another status. */
+sealed interface TransitionResult {
+    data class Moved(val from: ApplicationStatus, val to: ApplicationStatus) : TransitionResult
+
+    data class Rejected(val reason: TransitionRejection) : TransitionResult
+}
+
+enum class TransitionRejection { BACKWARDS_FROM_APPLIED, CLOSED_APPLICATION }
+
+/** The allowed moves of the status pipeline (spec §6.2). */
+object StatusPipeline {
+    fun check(from: ApplicationStatus, to: ApplicationStatus): TransitionRejection? =
+        when {
+            from == ApplicationStatus.APPLIED && to == ApplicationStatus.DISCOVERED ->
+                TransitionRejection.BACKWARDS_FROM_APPLIED
+            from.isTerminal ->
+                TransitionRejection.CLOSED_APPLICATION
+            else -> null
+        }
+}
