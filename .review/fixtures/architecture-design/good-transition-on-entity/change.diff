+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.application
+
+import io.github.scriptibus.jofi.applications.application.port.ApplicationRepositoryPort
+import io.github.scriptibus.jofi.applications.domain.ApplicationId
+import io.github.scriptibus.jofi.applications.domain.ApplicationStatus
+import io.github.scriptibus.jofi.applications.domain.TransitionResult
+
+/** Moves one application to another status; the entity decides whether the move is allowed. */
+class ChangeApplicationStatusUseCase(
+    private val applications: ApplicationRepositoryPort,
+) {
+    fun execute(id: ApplicationId, target: ApplicationStatus): ChangeStatusOutcome {
+        val application = applications.findById(id) ?: return ChangeStatusOutcome.NotFound
+        return when (val result = application.transitionTo(target)) {
+            is TransitionResult.Moved -> {
+                applications.save(application)
+                ChangeStatusOutcome.Changed(result)
+            }
+            is TransitionResult.Rejected -> ChangeStatusOutcome.NotAllowed(result.reason)
+        }
+    }
+}
