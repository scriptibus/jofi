+
+package io.github.scriptibus.jofi.applications.domain
+
+/** One job application and its place in the status pipeline. */
+class Application(
+    val id: ApplicationId,
+    val title: String,
+    status: ApplicationStatus,
+) {
+    var status: ApplicationStatus = status
+        private set
+
+    /** Moves to [target] if the pipeline allows it; otherwise leaves the application unchanged. */
+    fun transitionTo(target: ApplicationStatus): TransitionResult {
+        val rejection = StatusPipeline.check(status, target)
+        if (rejection != null) return TransitionResult.Rejected(rejection)
+        val from = status
+        status = target
+        return TransitionResult.Moved(from, target)
+    }
+}
