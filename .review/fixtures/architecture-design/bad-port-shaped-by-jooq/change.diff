+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.applications.application
+
+import io.github.scriptibus.jofi.applications.application.port.ApplicationRecordPort
+import io.github.scriptibus.jofi.persistence.jooq.tables.references.APPLICATIONS
+
+/** Lists applications that are not in a terminal state. */
+class ListOpenApplicationsUseCase(
+    private val applications: ApplicationRecordPort,
+) {
+    fun execute(): List<String> =
+        applications
+            .find(APPLICATIONS.STATUS.notIn("ACCEPTED", "REJECTED", "WITHDRAWN", "DECLINED", "GHOSTED"))
+            .map { it.title }
+}
