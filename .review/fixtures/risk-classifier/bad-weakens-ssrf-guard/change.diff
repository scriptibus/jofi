+package io.github.scriptibus.jofi.shared.adapter.net
+
+import java.net.InetAddress
+
+/** Hosts the SSRF guard lets through even when they resolve to private addresses (for local job boards). */
+object TrustedHosts {
+    private val trustedSuffixes = listOf(".local", ".internal", ".lan")
+
+    fun bypassesGuard(host: String): Boolean =
+        trustedSuffixes.any { host.endsWith(it) } ||
+            InetAddress.getByName(host).isSiteLocalAddress
+}
