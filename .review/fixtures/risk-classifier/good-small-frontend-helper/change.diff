+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import { describe, expect, it } from "vitest";
+import { formatSalaryRange } from "./formatSalary";
+
+describe("formatSalaryRange", () => {
+  it("formats a range in German", () => {
+    expect(formatSalaryRange(50000, 60000, "de-DE")).toBe("50.000\u00a0€–60.000\u00a0€");
+  });
+
+  it("formats a single amount when both ends are equal", () => {
+    expect(formatSalaryRange(50000, 50000, "en-GB")).toBe("€50,000");
+  });
+});
