+package io.github.scriptibus.jofi.scanners.adapter.scanners
+
+import io.github.scriptibus.jofi.scanners.application.port.PageFetchPort
+import io.github.scriptibus.jofi.scanners.domain.FetchedPage
+import org.springframework.web.client.RestClient
+import org.springframework.web.client.body
+
+/** Fetches the career page a page watcher observes. */
+class CareerPageFetcher : PageFetchPort {
+    private val client = RestClient.create()
+
+    override fun fetch(url: String): FetchedPage {
+        val html = client.get().uri(url).retrieve().body<String>().orEmpty()
+        return FetchedPage(url = url, html = html)
+    }
+}
