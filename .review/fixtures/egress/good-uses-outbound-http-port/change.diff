+package io.github.scriptibus.jofi.scanners.adapter.scanners
+
+import io.github.scriptibus.jofi.scanners.application.port.PageFetchPort
+import io.github.scriptibus.jofi.scanners.domain.FetchedPage
+import io.github.scriptibus.jofi.shared.application.port.OutboundHttpPort
+import io.github.scriptibus.jofi.shared.application.port.OutboundRequest
+
+/** Fetches the career page a page watcher observes, through the SSRF-guarded client in adapters/net. */
+class CareerPageFetcher(
+    private val http: OutboundHttpPort,
+) : PageFetchPort {
+    override fun fetch(url: String): FetchedPage {
+        val response = http.fetch(OutboundRequest.get(url, respectRobotsTxt = true))
+        return FetchedPage(url = url, html = response.bodyAsText())
+    }
+}
