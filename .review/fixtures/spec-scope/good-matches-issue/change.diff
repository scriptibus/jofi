+++ b/backend/domain/src/test/kotlin/io/github/scriptibus/jofi/tasks/domain/TaskTest.kt
@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.tasks.domain
+
+import java.time.LocalDate
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class TaskTest {
+    private val due = LocalDate.of(2026, 10, 1)
+
+    @Test
+    fun `is overdue after the due date`() {
+        assertTrue(Task(TaskId("t1"), "Follow up", due).isOverdue(due.plusDays(1)))
+    }
+
+    @Test
+    fun `is not overdue on the due date, without one, or when done`() {
+        assertFalse(Task(TaskId("t1"), "Follow up", due).isOverdue(due))
+        assertFalse(Task(TaskId("t2"), "Follow up").isOverdue(due))
+        assertFalse(Task(TaskId("t3"), "Follow up", due, done = true).isOverdue(due.plusDays(1)))
+    }
+}
