+// SPDX-FileCopyrightText: 2026 Jofi contributors
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package io.github.scriptibus.jofi.tasks.domain
+
+import java.time.LocalDate
+
+@JvmInline
+value class TaskId(val value: String)
+
+/** Something the user wants to do, optionally by a date. */
+data class Task(
+    val id: TaskId,
+    val title: String,
+    val dueDate: LocalDate? = null,
+    val done: Boolean = false,
+) {
+    fun isOverdue(today: LocalDate): Boolean = !done && dueDate != null && today.isAfter(dueDate)
+}
diff --git a/backend/domain/src/test/kotlin/io/github/scriptibus/jofi/tasks/domain/TaskTest.kt b/backend/domain/src/test/kotlin/io/github/scriptibus/jofi/tasks/domain/TaskTest.kt
