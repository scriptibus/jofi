{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits", "security:minimumReleaseAgeNpm"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Patch and minor updates of stable versions merge automatically once all checks are green (AGENTS.md section 8).",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Pre-release pins (see docs/adr) are only updated by hand.",
      "matchPackageNames": ["/^dev\\.detekt/"],
      "automerge": false
    },
    {
      "description": "Group the Spring ecosystem so Boot, Modulith and AI move together.",
      "matchPackageNames": ["/^org\\.springframework/"],
      "groupName": "spring"
    },
    {
      "description": "Group Kotlin compiler and plugins.",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin/"],
      "groupName": "kotlin"
    }
  ]
}
