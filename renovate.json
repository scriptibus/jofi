{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "security:minimumReleaseAgeNpm"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Renovate never merges on its own: the auto-merge gate in lenses.yml is the only auto-merge path (ADR 0023). It lets patch/minor updates of dependency files through.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin",
        "pinDigest"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": false,
      "platformAutomerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pre-release pins (see docs/adr) are only updated by hand.",
      "matchPackageNames": [
        "/^dev\\.detekt/"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group the Spring ecosystem so Boot, Modulith and AI move together.",
      "matchPackageNames": [
        "/^org\\.springframework/"
      ],
      "groupName": "spring",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group Kotlin compiler and plugins.",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/"
      ],
      "groupName": "kotlin",
      "minimumReleaseAge": "7 days"
    }
  ]
}
