#
# Configuration for compose.yaml. Copy it and adjust:  cp .env.example .env
# .env is gitignored; never commit it. This file holds no secrets, only placeholders.

# --- Network -------------------------------------------------------------------------------------
# Host address the app is published on. The default keeps Jofi reachable from this machine only.
# To reach it from other devices, set 0.0.0.0 (all interfaces) or one interface's address, and only
# do so once login is enabled; for phone use prefer Tailscale (see README "Run it").
JOFI_BIND_ADDRESS=127.0.0.1
# Host port of the web UI and API: http://127.0.0.1:8080
JOFI_PORT=8080

# --- Database ------------------------------------------------------------------------------------
# PostgreSQL user and password, used by the db container and by app and worker to connect.
# The database is not published on the host. Change the password before the first start;
# changing it later needs an ALTER ROLE inside the database as well.
JOFI_DB_USERNAME=jofi
JOFI_DB_PASSWORD=change-me

# --- JVM -----------------------------------------------------------------------------------------
# Extra JVM options for app and worker (passed as JAVA_TOOL_OPTIONS), e.g. -XX:MaxRAMPercentage=50
JOFI_JAVA_OPTIONS=

# --- Login, sessions and secrets ------------------------------------------------------------------
# Where Jofi keeps the master keyset and the setup token. Set by the image (/data); only needed outside Docker.
# JOFI_DATA_DIR=/absolute/path/to/data
# CIDRs of a TLS proxy in front of Jofi whose X-Forwarded-* headers are trusted (default: loopback only).
# JOFI_TRUSTED_PROXIES=127.0.0.0/8, ::1/128
# Idle timeout of a login session (default 7d) and its absolute lifetime since login (default 30d).
# JOFI_SESSION_TIMEOUT=7d
# JOFI_SESSION_MAX_AGE=30d
# Forgot the password? Set to true, start once, then remove it again: deletes the login (not your data),
# ends every session and issues a new setup token (docker compose exec app cat /data/secrets/setup-token).
# JOFI_RESET_PASSWORD=false
# Only if the master keyset in the data volume is lost for good: start once with true, then enter the
# API keys again and remove it. Without it Jofi refuses to start rather than lose the stored secrets.
# JOFI_ACCEPT_SECRET_LOSS=false
